# Production settings for docker-compose.prod.yml. Copy to .env on the server and fill in every
# value; never commit the filled-in file. Tuning options (agent limits, embeddings, jobs) are
# documented in .env.example and work the same here. See docs/deployment.md.

# --- Site --------------------------------------------------------------------
# Public HTTPS address (no trailing slash). OAuth callbacks and CORS derive from it.
FRONTEND_URL=https://repoguide.example.com
# Public host name, plus localhost for the container health check.
DJANGO_ALLOWED_HOSTS=repoguide.example.com,localhost
# 50+ random characters:  python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# Separate JWT signing key (rotating it signs everyone out):  same command as above
JWT_SIGNING_KEY=
LOG_LEVEL=INFO

# --- GitHub OAuth App (https://github.com/settings/developers) ----------------
#   Homepage URL:               https://repoguide.example.com
#   Authorization callback URL: https://repoguide.example.com/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Encrypts stored GitHub tokens. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotate by putting a new key first (comma-separated) and keeping the old ones after it.
# Losing every key means users must sign in again to re-link GitHub.
TOKEN_ENCRYPTION_KEYS=

# --- MongoDB -----------------------------------------------------------------
# Bundled container (single host): set a strong password; MONGODB_URI is derived from it.
# Use only URL-safe characters (letters, digits, - _ . ~) or URL-encode it.
MONGO_ROOT_USER=repoguide
MONGO_ROOT_PASSWORD=
MONGODB_DB=repoguide
# MongoDB Atlas instead: set the cluster URI (Atlas Search + Vector Search are required).
# MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/?retryWrites=true

# --- Model server (OpenAI-compatible, e.g. vLLM) ------------------------------
LLM_BASE_URL=https://llm.example.com/v1
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen3-8B

# --- HTTPS -------------------------------------------------------------------
# Redirect plain HTTP to HTTPS in Django (keep true unless the proxy already does it).
SECURE_SSL_REDIRECT=true
# Opt in to HSTS once HTTPS works everywhere, e.g. 3600 first, then 31536000.
SECURE_HSTS_SECONDS=0

# --- Capacity ----------------------------------------------------------------
# Parallel ingestion/analysis tasks per worker container (each holds the embedding model).
CELERY_CONCURRENCY=2
RATE_LIMIT_NEW_ANALYSES=5/hour
RATE_LIMIT_CHAT_QUESTIONS=30/hour

# Where the frontend container listens (put the TLS proxy in front of it).
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
