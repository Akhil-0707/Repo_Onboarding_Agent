# Copy to .env and fill in. Never commit .env.

# --- Django ---------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=INFO
LOG_JSON=true

# --- MongoDB (docker compose builds MONGODB_URI from these) ---------------
MONGO_ROOT_USER=repoguide
MONGO_ROOT_PASSWORD=change-me
MONGODB_DB=repoguide
# Only needed when running the backend outside docker:
# MONGODB_URI=mongodb://repoguide:change-me@localhost:27017/?directConnection=true&authSource=admin
# REDIS_URL=redis://localhost:6379/0

# --- Self-hosted LLM (vLLM on Kaggle, or any OpenAI-compatible server) ----
# Paste the tunnel URL printed by kaggle/serve_model.py. You can also change it later
# without restarting: docker compose exec backend python manage.py set_llm_url <url>
LLM_BASE_URL=https://your-tunnel.trycloudflare.com/v1
LLM_API_KEY=the-same-key-you-stored-in-kaggle-secrets
LLM_MODEL=Qwen/Qwen3-8B
LLM_CONNECT_TIMEOUT=10
LLM_READ_TIMEOUT=120
LLM_MAX_RETRIES=3
# Qwen3 "thinking" off: faster, cleaner JSON. Set false for models without that template flag.
LLM_DISABLE_THINKING=true
# Use vLLM guided decoding (response_format json_schema) for structured sections.
LLM_GUIDED_JSON=true
# Optional cost estimate per 1k tokens (0 for self-hosted).
LLM_COST_PER_1K_INPUT=0
LLM_COST_PER_1K_OUTPUT=0

# --- Rate limits ----------------------------------------------------------
RATE_LIMIT_NEW_ANALYSES=5/hour
