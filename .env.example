# Copy to .env and fill in. Never commit .env.

# --- Django ---------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=INFO
LOG_JSON=true

# Separate key for signing JWTs (defaults to DJANGO_SECRET_KEY). Use 32+ random characters.
JWT_SIGNING_KEY=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- GitHub OAuth -----------------------------------------------------------
# Create an OAuth App at https://github.com/settings/developers
#   Homepage URL:               http://localhost:5173
#   Authorization callback URL: http://localhost:5173/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GITHUB_OAUTH_REDIRECT_URI=http://localhost:5173/api/auth/github/callback

# Fernet key(s) that encrypt stored GitHub tokens. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separate several to rotate (the first one encrypts). Required when DJANGO_DEBUG=false.
TOKEN_ENCRYPTION_KEYS=
# Set true when serving over HTTPS.
AUTH_COOKIE_SECURE=false

# --- MongoDB (docker compose builds MONGODB_URI from these) ---------------
MONGO_ROOT_USER=repoguide
MONGO_ROOT_PASSWORD=change-me
MONGODB_DB=repoguide
# Only needed when running the backend outside docker:
# MONGODB_URI=mongodb://repoguide:change-me@localhost:27017/?directConnection=true&authSource=admin
# REDIS_URL=redis://localhost:6379/0

# --- Self-hosted LLM (vLLM on Kaggle, or any OpenAI-compatible server) ----
# Paste the tunnel URL printed by kaggle/serve_model.py. You can also change it later
# without restarting: docker compose exec backend python manage.py set_llm_url <url>
LLM_BASE_URL=https://your-tunnel.trycloudflare.com/v1
LLM_API_KEY=the-same-key-you-stored-in-kaggle-secrets
LLM_MODEL=Qwen/Qwen3-8B
LLM_CONNECT_TIMEOUT=10
LLM_READ_TIMEOUT=120
LLM_MAX_RETRIES=3
# Qwen3 "thinking" off: faster, cleaner JSON. Set false for models without that template flag.
LLM_DISABLE_THINKING=true
# Use vLLM guided decoding (response_format json_schema) for structured sections.
LLM_GUIDED_JSON=true
# Optional cost estimate per 1k tokens (0 for self-hosted).
LLM_COST_PER_1K_INPUT=0
LLM_COST_PER_1K_OUTPUT=0

# --- Embeddings ------------------------------------------------------------
# "local" runs sentence-transformers on CPU in the worker (no dependency on the Kaggle model).
# "openai" uses any OpenAI-compatible /v1/embeddings endpoint (EMBEDDING_BASE_URL/API_KEY).
# Changing the model/dimensions requires re-analysing repositories (vectors are not comparable).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=64
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# Optional Hugging Face token: faster, rate-limit-free model downloads.
# HF_TOKEN=

# --- Agent limits (defaults shown) -----------------------------------------
# ANALYSIS_MAX_ITERATIONS=6        # tool-calling steps per section
# ANALYSIS_TOKEN_BUDGET=300000     # per repository analysis
# ANALYSIS_MAX_WAIT_HOURS=48       # give up waiting for an offline model
# CHAT_MAX_ITERATIONS=5            # tool-calling steps per answer
# CHAT_TOKEN_BUDGET=60000          # per answer
# CHAT_ANSWER_MAX_TOKENS=1500
# CHAT_HISTORY_TURNS=4             # recent turns sent verbatim; older ones are summarised
# CHAT_MAX_QUESTION_CHARS=4000

# --- Rate limits ----------------------------------------------------------
# New analyses per user; opening a repository someone already analysed is free.
RATE_LIMIT_NEW_ANALYSES=5/hour

# --- Jobs and access (defaults shown) --------------------------------------
# INGEST_STALE_MINUTES=30              # fail running jobs with no progress for this long
# INGEST_QUEUED_TIMEOUT_MINUTES=360    # fail jobs that never left the queue
# PRIVATE_ACCESS_RECHECK_HOURS=6       # re-confirm GitHub access to private repos this often
# PRIVATE_ACCESS_GRACE_HOURS=168       # keep serving if GitHub is down, up to this long
# EMBEDDING_WARMUP=1                   # load the embedding model when the API starts

# --- Host ports (change if they clash with other local services) ----------
BACKEND_HOST_PORT=8010
FRONTEND_HOST_PORT=5173
MONGO_HOST_PORT=27017
REDIS_HOST_PORT=6379
